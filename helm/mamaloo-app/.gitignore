*.tgz
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Diretórios temporários
tmp/
temp/
.tmp/

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Output de template
/manifests.yaml
/manifests-*.yaml
